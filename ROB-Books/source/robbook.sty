\newcommand{\ROBStopChainDiagram}{%
  \begin{center}
  \begin{tikzpicture}[node distance=5mm and 5mm,every node/.style={font=\robcondensed\scriptsize,align=center}]
    \tikzstyle{softstop}=[draw=ROBAmber!90!black,fill=ROBAmber!8,rounded corners=1mm,minimum width=1.18in,minimum height=0.55in]
    \tikzstyle{hardstop}=[draw=ROBRed,fill=ROBRed!8,rounded corners=1mm,minimum width=1.65in,minimum height=0.55in]
    \node[softstop] (intent) {input released\\or manual stop};
    \node[softstop,right=of intent] (lease) {controller-specific\\lease / watchdog};
    \node[softstop,right=of lease] (watch) {Cerebro 0.6 s\\freshness gate};
    \node[softstop,right=of watch] (dead) {Arduino serial\\deadman};
    \node[softstop,right=of dead] (zero) {commanded stop;\\result must be tested};
    \draw[->,thick,ROBAmber!90!black] (intent) -- (lease);
    \draw[->,thick,ROBAmber!90!black] (lease) -- (watch);
    \draw[->,thick,ROBAmber!90!black] (watch) -- (dead);
    \draw[->,thick,ROBAmber!90!black] (dead) -- (zero);
    \node[hardstop,below=8mm of watch] (hard) {required verified physical E-stop};
    \node[hardstop,right=10mm of hard] (isolate) {independent contactor / controller stop path};
    \draw[->,very thick,ROBRed] (hard) -- node[above,font=\robcondensed\tiny,text=ROBRed]{independent of software} (isolate);
  \end{tikzpicture}
  \end{center}
}

